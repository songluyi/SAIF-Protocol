{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/songluyi/SAIF-Protocol/v0.3.0/schemas/settlement.schema.json",
  "x-saif-version": "0.3.0",
  "title": "SAIF Settlement",
  "description": "The final settlement representation associated with an Execution.",
  "type": "object",
  "required": [
    "id",
    "type",
    "created_at",
    "metadata",
    "execution_id",
    "status",
    "details"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "payment",
        "refund",
        "invoice",
        "accounting_record"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    },
    "execution_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "SETTLED",
        "REFUNDED"
      ]
    },
    "details": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
