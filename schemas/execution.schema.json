{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/songluyi/SAIF-Protocol/v0.3.0/schemas/execution.schema.json",
  "x-saif-version": "0.3.0",
  "title": "SAIF Execution",
  "description": "The status and result of real-world provider execution.",
  "type": "object",
  "required": [
    "id",
    "type",
    "created_at",
    "metadata",
    "order_id",
    "provider_id",
    "status",
    "result"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "shipment",
        "printing",
        "robot_operation",
        "service_completion"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    },
    "order_id": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "RUNNING",
        "COMPLETED",
        "FAILED"
      ]
    },
    "result": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
