{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/songluyi/SAIF-Protocol/v0.3.0/schemas/authorization-decision.schema.json",
  "x-saif-version": "0.3.0",
  "title": "SAIF Authorization Decision",
  "description": "A portable, revision-bound outcome of evaluating an Authorization for a Request.",
  "type": "object",
  "required": [
    "id",
    "type",
    "created_at",
    "metadata",
    "saif_version",
    "request_ref",
    "authorization_ref",
    "agent_id",
    "owner_id",
    "decision",
    "evaluated_scope",
    "reason_codes",
    "evaluated_at",
    "expires_at",
    "correlation_id",
    "policy_profile"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "const": "authorization_decision" },
    "created_at": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object" },
    "saif_version": { "const": "0.3.0" },
    "request_ref": { "$ref": "#/$defs/revisionedReference" },
    "authorization_ref": { "$ref": "#/$defs/revisionedReference" },
    "agent_id": { "type": "string", "minLength": 1 },
    "owner_id": { "type": "string", "minLength": 1 },
    "decision": {
      "type": "string",
      "enum": ["ALLOW", "DENY", "REQUIRES_ACTION"]
    },
    "evaluated_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$" }
    },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "expires_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "correlation_id": { "type": "string", "minLength": 1 },
    "policy_profile": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "revisionedReference": {
      "type": "object",
      "required": ["id", "revision"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "decision": { "const": "ALLOW" } },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "expires_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  ],
  "additionalProperties": false
}
