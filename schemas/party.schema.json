{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/songluyi/SAIF-Protocol/schemas/party.schema.json",
  "title": "SAIF Party",
  "description": "A real-world entity participating in a SAIF business lifecycle.",
  "type": "object",
  "required": [
    "id",
    "type",
    "created_at",
    "metadata"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "individual",
        "organization",
        "ai_system",
        "service_provider"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    },
    "name": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
